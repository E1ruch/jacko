# Local API using PostgreSQL and Redis from deploy/compose.yaml.
JACKO_DATABASE_URL='postgres://jacko:jacko@127.0.0.1:5432/jacko?sslmode=disable'
JACKO_REDIS_URL='redis://127.0.0.1:6379/0'
JACKO_REDIS_TOPIC='jacko:v1:messages'
JACKO_HTTP_ADDR='127.0.0.1:8080'
JACKO_METRICS_ADDR='127.0.0.1:9090'

# Private local S3 bucket created by deploy/compose.yaml.
JACKO_S3_URL='http://127.0.0.1:9000'
JACKO_S3_REGION='us-east-1'
JACKO_S3_BUCKET='jacko'
JACKO_S3_ACCESS_KEY='jacko-local'
JACKO_S3_SECRET_KEY='jacko-local-storage'

# Optional local beta email via Mailpit. Enable both to require verified email at login.
# JACKO_SMTP_ADDR='127.0.0.1:1025'
# JACKO_SMTP_FROM='jacko@jacko.test'
# JACKO_SMTP_USER=''
# JACKO_SMTP_PASSWORD=''
